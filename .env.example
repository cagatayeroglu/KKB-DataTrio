# Blank local configuration template: copy to ignored .env if needed.
# Never put real credentials in this file, tests, logs, or Git history.
# The organizer restates this: keep the MIA key out of screenshots, slides,
# chats and browser-side code, and never commit a file containing it -- not
# even to a private repository.
#
# Every value here stays blank, including the non-secret ones; the repository
# hygiene test enforces that, and a template that carries some real values is
# a template people stop reading before the one secret line. The organizer's
# confirmed public values are given as comments instead. DEC-129 is the
# authority for all of them.
#
# Two ways in, both read by src/kkb_agent/llm/config.py: export these into the
# environment, or hand the local API a copy with --env-file. That reader is
# literal: NAME=value lines only, no interpolation, a repeated name refuses the
# whole file ("Duplicate Kloudeks setting") rather than letting the last one
# win. The transport in src/kkb_agent/llm/kloudeks.py refuses any base URL but
# the confirmed one.

# Required. BASE_URL must be https, or the credential travels in the clear.
# Confirmed value: https://mia.csp.kloudeks.com/v1
KLOUDEKS_BASE_URL=
# The team's MIA API key. This is the only secret in this file.
KLOUDEKS_API_KEY=

# Copy model identifiers verbatim: the kkbhackathon2026/ prefix and the exact
# case are part of the model ID, and a mistyped one returns 401/403 rather
# than falling back to anything. The platform publishes one chat/text/vision
# model, so planner and router currently name the same identifier.
# Confirmed value for both: kkbhackathon2026/Qwen3.8-27B
KLOUDEKS_PLANNER_MODEL=
KLOUDEKS_ROUTER_MODEL=

# Optional. An absent model means the capability is reported unavailable
# rather than assumed; see ProviderConfig.capabilities().
# Vision is the same chat model, kkbhackathon2026/Qwen3.8-27B, max 5 images
# per prompt. Embedding is kkbhackathon2026/Qwen3-Embedding-8B; its vector
# dimension is undocumented and was measured as 4096 on 2026-09-11 (Q-K-05).
# OCR uses a separate model, kkbhackathon2026/Unlimited-OCR (max 3 images): it
# reads the text of a scanned page or an uploaded picture, nothing more.
# VISION must not name the OCR model. Asked what a chart shows, Unlimited-OCR
# answers with layout boxes, so the API reports "vision": false and refuses to
# interpret pictures when the two settings are equal (DEC-181).
KLOUDEKS_OCR_MODEL=
KLOUDEKS_VISION_MODEL=
KLOUDEKS_EMBEDDING_MODEL=

# Optional. STRUCTURED_OUTPUT defaults to false and stays there: the endpoint
# is OpenAI-compatible and vLLM-backed, but no organizer guidance confirms
# guaranteed JSON-schema output (Q-K-03), so the repair-and-retry fallback
# remains the default path. REQUEST_TIMEOUT defaults to 30 seconds, which a
# live plan does not fit: on 2026-09-20 one completion took 867 s. The local
# API accepts 1 through 1800; a served deployment sets 1800. MAX_ATTEMPTS is 1
# through 3 and only re-asks a malformed answer, never a timed-out request.
KLOUDEKS_STRUCTURED_OUTPUT=
KLOUDEKS_REQUEST_TIMEOUT=
KLOUDEKS_MAX_OUTPUT_TOKENS=
KLOUDEKS_MAX_ATTEMPTS=
# Optional. The served Qwen reasons before it answers unless told not to. Both
# default to true: plans need the reasoning, and the writer's answer quality
# was judged worth its seconds (decision of 2026-09-20). Set false only to measure.
KLOUDEKS_PLANNER_THINKING=
KLOUDEKS_WRITER_THINKING=
