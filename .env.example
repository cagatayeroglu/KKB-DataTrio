# Blank local configuration template: copy to ignored .env if needed.
# Never put real credentials in this file, tests, logs, or Git history.
# These names are provisional local conventions, not confirmed Kloudeks API
# contracts. M0-05 reconciles them with the provider after Q-K-01/02/03 answers.
# No .env loader or live provider transport is implemented yet; the offline
# boundary that reads these lives in src/kkb_agent/llm/config.py.
# Keep values empty until the organizer confirms endpoint/auth/model details.

# Required. BASE_URL must be https, or the credential travels in the clear.
KLOUDEKS_BASE_URL=
KLOUDEKS_API_KEY=
KLOUDEKS_PLANNER_MODEL=
KLOUDEKS_ROUTER_MODEL=

# Optional. An absent model means the capability is reported unavailable
# rather than assumed; see ProviderConfig.capabilities().
KLOUDEKS_VISION_MODEL=
KLOUDEKS_EMBEDDING_MODEL=

# Optional. STRUCTURED_OUTPUT defaults to false, so the repair-and-retry
# fallback runs until the platform is confirmed to support JSON mode (Q-K-03).
KLOUDEKS_STRUCTURED_OUTPUT=
KLOUDEKS_REQUEST_TIMEOUT=
KLOUDEKS_MAX_ATTEMPTS=
